# ---------------------------------------------------------------
# LMS environment configuration
# Copy this file to .env.local and edit as needed.
# ---------------------------------------------------------------

# "demo" = simulate payments locally (no real money).
# "live" = real payments via Flutterwave (needs keys + public URL).
PAYMENT_MODE=demo

# Your site URL (used to build payment redirect links)
SITE_URL=http://localhost:3000

# Flutterwave keys (only needed when PAYMENT_MODE=live)
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=

# Currency code: KES, USD, etc.
CURRENCY=KES
